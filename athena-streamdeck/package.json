{
  "name": "athena-streamdeck",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/runtime.test.mjs",
    "build": "node scripts/build.mjs",
    "validate": "streamdeck validate com.themicrosoftcloudblog.athena.sdPlugin",
    "pack": "npm run build && streamdeck pack com.themicrosoftcloudblog.athena.sdPlugin --output dist --force"
  },
  "dependencies": { "@elgato/streamdeck": "^3.0.3" },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4",
    "ws": "^8.18.0",
    "node": "^24.0.0"
  }
}

{
  "name": "athena-desktop",
  "productName": "Athena",
  "version": "0.1.7",
  "private": true,
  "description": "Athena desktop app: the Athena web app plus access to folders on this PC.",
  "main": "build/src/main.js",
  "author": "Richard Hogan",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "start:chat": "npm run build && electron . --chat",
    "start:local": "npm run build && cross-env ATHENA_URL=http://localhost:5173 electron .",
    "test": "npm run build && node --test build/test/desktop.test.js build/test/dailyInsights.test.js",
    "test:navigation": "npm run build && node test/run-navigation.cjs",
    "test:elgato": "npm run build && node --test build/test/elgato.test.js",
    "dist": "npm run build && electron-builder --win nsis",
    "release": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "cross-env": "^7.0.3",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.themicrosoftcloudblog.athena",
    "productName": "Athena",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "build/src/**/*.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Athena",
      "include": "installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "richardichogan",
        "repo": "knowledge-base",
        "releaseType": "release"
      }
    ]
  }
}

# Production build config — loaded automatically by Vite during `npm run build`.
#
# IMPORTANT: These MUST stay set. If VITE_API_URL is empty, the deployed frontend
# calls /api on the Static Web Apps host (which has no backend) and the whole app
# shows "no data". Committing this file means every production build bakes in the
# correct backend URL — the value can never be forgotten on a rebuild again.
#
# Values here are NOT secrets: the API URL is public, and the Entra ids below are
# public identifiers.

# Azure Container Apps backend (kh-prod-api-vnet — VNet-injected env with NAT gateway + private endpoint to Postgres)
VITE_API_URL=https://kh-prod-api-vnet.proudcoast-0a102078.uksouth.azurecontainerapps.io

# Microsoft sign-in (Entra ID, IBM Alliance tenant) — app registration
# Digital-Steward-Governance-SinglePane, API scope api://<client id>/access_as_user.
# Not secrets: public identifiers.
VITE_ENTRA_CLIENT_ID=aa306537-2615-4382-b97e-a03975a62304
VITE_ENTRA_TENANT_ID=740bc3aa-5daf-42f6-939a-b2d007a60d26

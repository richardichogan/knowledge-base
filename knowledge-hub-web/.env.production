# Production build config — loaded automatically by Vite during `npm run build`.
#
# IMPORTANT: These MUST stay set. If VITE_API_URL is empty, the deployed frontend
# calls /api on the Static Web Apps host (which has no backend) and the whole app
# shows "no data". Committing this file means every production build bakes in the
# correct backend URL — the value can never be forgotten on a rebuild again.
#
# Values here are NOT secrets: the API URL is public, and the password hash is a
# one-way SHA-256 used only by the client-side gate.

# Azure Container Apps backend (kh-prod-api)
VITE_API_URL=https://kh-prod-api.blueisland-fcfc1a56.uksouth.azurecontainerapps.io

# Client-side password gate — SHA-256 of the admin password
VITE_APP_PASSWORD_HASH=e567f5234b7ae34944a65d362f2cd3357d5fdb8462c2f0fe3bd7be892942365c

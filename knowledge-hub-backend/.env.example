# ─── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_hub
PORT=3000

# Blog workforce pilot: leave disabled until explicit pilot/release approval,
# migrations and old-worker drain are verified, and an owner-approved numeric
# call/token/deadline profile is enabled. This flag alone grants no budget.
ATHENA_WORKFORCE_MANUAL_BLOG=false

# ─── Azure AI Foundry (required for AI Chat) ──────────────────────────────────
# Point these at your Azure OpenAI resource / AI Foundry endpoint.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Voice chat (Azure Speech REST API) — ported from client-demo's voiceProvider.ts.
# AZURE_SPEECH_KEY is optional; if unset it falls back to AZURE_OPENAI_API_KEY
# (the multi-service Azure AI Services key also covers the Speech REST API).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uksouth
AZURE_SPEECH_VOICE=en-US-Harper:MAI-Voice-2
AZURE_SPEECH_FALLBACK_VOICE=en-US-SaraNeural
# Set to "mock" to force the deterministic mock voice provider (no network).
VOICE_PROVIDER=

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
ADMIN_PASSWORD=dev-password

# ─── Azure Blob Storage (CMS content) ────────────────────────────────────────
# For local dev, use connection string. In production, use Managed Identity.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_BLOB_ACCOUNT_URL=https://youraccount.blob.core.windows.net

# Athena uploads, local-folder sync and chat files (not the CMS/blog account).
# ATHENA_STORAGE_ACCOUNT_NAME=your-athena-storage-account
# ATHENA_STORAGE_ACCOUNT_KEY=

# ─── Microsoft Graph (optional — calendar/todo sync) ──────────────────────────
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_TENANT_ID=
# GRAPH_REDIRECT_URI=http://localhost:3000/auth/graph/callback
# GRAPH_REFRESH_TOKEN=

# ─── GitLab (optional) ────────────────────────────────────────────────────────
# GITLAB_ACCESS_TOKEN=
# CREDENTIAL_ENCRYPTION_KEY=  # stable secret, at least 32 characters; otherwise GRAPH_CLIENT_SECRET is used
# GITLAB_USER_ID=

# ─── GitHub (optional) ────────────────────────────────────────────────────────
# GITHUB_ACCESS_TOKEN=
# GITHUB_USERNAME=

# LinkedIn personal-profile publishing (optional; alternatively save in My Work > Sync Status).
# Requires openid, profile and w_member_social; renew manually when the token expires.
# LINKEDIN_ACCESS_TOKEN=

# ─── Build pipeline (optional — GitHub cloud coding agents) ───────────────────
# User fine-grained PAT: read/write contents, issues, pull requests, actions.
# GITHUB_AGENT_TOKEN=
# The runner is off in development unless this is "true".
# BUILD_RUNNER_ENABLED=

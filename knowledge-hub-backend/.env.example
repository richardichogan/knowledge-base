# ─── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_hub
PORT=3000

# ─── Azure AI Foundry (required for AI Chat) ──────────────────────────────────
# Point these at your Azure OpenAI resource / AI Foundry endpoint.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Optional — voice chat (leave unset to hide mic/speaker controls in the UI)
AZURE_OPENAI_DEPLOYMENT_WHISPER=whisper
AZURE_OPENAI_DEPLOYMENT_TTS=tts

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
ADMIN_PASSWORD=dev-password

# ─── Azure Blob Storage (CMS content) ────────────────────────────────────────
# For local dev, use connection string. In production, use Managed Identity.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_BLOB_ACCOUNT_URL=https://youraccount.blob.core.windows.net

# ─── Microsoft Graph (optional — calendar/todo sync) ──────────────────────────
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_TENANT_ID=
# GRAPH_REDIRECT_URI=http://localhost:3000/auth/graph/callback
# GRAPH_REFRESH_TOKEN=

# ─── GitLab (optional) ────────────────────────────────────────────────────────
# GITLAB_ACCESS_TOKEN=
# GITLAB_USER_ID=

# ─── GitHub (optional) ────────────────────────────────────────────────────────
# GITHUB_ACCESS_TOKEN=
# GITHUB_USERNAME=
